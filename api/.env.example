# Meu Fiscal · API única — variáveis de ambiente
# Em produção, cadastre no painel do Render (Environment). Em desenvolvimento, copie para api/.env.

NODE_ENV=production

# PostgreSQL (Neon). Use a string "pooled" aqui e a "direct" abaixo (o tempo real precisa de conexão direta).
DATABASE_URL=postgres://usuario:senha@ep-xxxx-pooler.sa-east-1.aws.neon.tech/meufiscal?sslmode=require
DATABASE_URL_DIRECT=postgres://usuario:senha@ep-xxxx.sa-east-1.aws.neon.tech/meufiscal?sslmode=require
PG_POOL=5

# Dois segredos DIFERENTES, 32+ caracteres cada (o Render gera sozinho pelo render.yaml):
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET_CLIENTE=
JWT_SECRET_PAINEL=

# CORS estrito: só estes domínios falam com a API (separe vários por vírgula, sem barra no final)
ORIGENS_CLIENTE=https://meufiscal-cliente.vercel.app
ORIGENS_PAINEL=https://meufiscal-painel.vercel.app

# Endereço público desta API (usado pelo tempo real)
URL_PUBLICA_API=https://meufiscal-api.onrender.com

# Arquivos: Cloudflare R2 (ou qualquer S3). ARQUIVOS_DRIVER=disco só para desenvolvimento.
ARQUIVOS_DRIVER=s3
S3_ENDPOINT=https://<ID-DA-CONTA>.r2.cloudflarestorage.com
S3_REGIAO=auto
S3_BUCKET=meufiscal-arquivos
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Opcional: e-mails de convite e de redefinição de senha (Resend, plano gratuito).
# Sem chave, o painel mostra o link do convite para você enviar por WhatsApp.
RESEND_API_KEY=
EMAIL_REMETENTE="Meu Fiscal <nao-responda@seudominio.com.br>"

# Opcional: Copiloto de IA (cobrado por uso na conta da Anthropic). Sem chave, o copiloto encaminha à equipe.
ANTHROPIC_API_KEY=
IA_MODELO=claude-sonnet-5-5
