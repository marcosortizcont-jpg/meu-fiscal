{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "echo \"sem dependências\"",
  "buildCommand": "node ../build.mjs cliente",
  "outputDirectory": "dist",
  "redirects": [
    {
      "source": "/admin",
      "destination": "/login",
      "permanent": false
    },
    {
      "source": "/admin/:caminho*",
      "destination": "/login",
      "permanent": false
    },
    {
      "source": "/cadastro",
      "destination": "/#comecar",
      "permanent": false
    },
    {
      "source": "/primeiro-acesso",
      "destination": "/login?primeiro-acesso",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/api/:caminho*",
      "destination": "https://meufiscal-api.onrender.com/api/:caminho*"
    },
    {
      "source": "/login",
      "destination": "/login.html"
    },
    {
      "source": "/definir-senha",
      "destination": "/login.html"
    },
    {
      "source": "/dashboard",
      "destination": "/app.html"
    },
    {
      "source": "/termos",
      "destination": "/legal.html"
    },
    {
      "source": "/privacidade",
      "destination": "/legal.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline' https://cdnjs.cloudflare.com https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob: https://*.r2.cloudflarestorage.com; media-src 'self' blob: https://*.r2.cloudflarestorage.com; connect-src 'self' https://meufiscal-api.onrender.com https://*.r2.cloudflarestorage.com; worker-src 'self' blob:; frame-src 'self' blob: https://*.r2.cloudflarestorage.com; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(self), geolocation=(), payment=()"
        }
      ]
    },
    {
      "source": "/(app|login|acessos|index|legal).html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    }
  ]
}
